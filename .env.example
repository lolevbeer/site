# Required core server configuration
# Safe local MongoDB default; replace it with the target environment's database.
DATABASE_URI=mongodb://127.0.0.1/lolev-beer
# Required non-placeholder secret; use a unique value in every environment.
PAYLOAD_SECRET=

# Required in production
# Required when VERCEL_ENV=production; optional for local development.
BLOB_READ_WRITE_TOKEN=

# Optional server integrations
# Routes remain unauthorized when these secrets are unset.
CRON_SECRET=
REVALIDATE_SECRET=

# Configure both Slack values or neither; server validation rejects a partial pair.
# See README "Slack bot" for required scopes and role-based access.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# Optional distributor geocoding fallbacks
GEOCODIO_API_KEY=
BING_MAPS_API_KEY=

# Public build-time values
# These values may be included in client output; never put secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
GOOGLE_SITE_VERIFICATION=

# Local/CI E2E only — never use these values or targets in production
# The seed writes data and accepts loopback databases by default. Remote disposable
# databases require E2E_DISPOSABLE_DATABASE=1 and a name ending in -e2e or -ci.
E2E_DISPOSABLE_DATABASE=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# The seed fails closed if this is true.
PAYLOAD_DROP_DATABASE=false
