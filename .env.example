# Database
DATABASE_URI=mongodb://127.0.0.1/lolev-beer

# Payload CMS
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Vercel Blob Storage (for media uploads)
BLOB_READ_WRITE_TOKEN=

# Site URL (set automatically on Vercel, override for local dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapbox (beer map page)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# Google Sheets sync (beer/menu/event/food data import)

# Cron & revalidation secrets
CRON_SECRET=
REVALIDATE_SECRET=

# Slack bot (/lolevbeer slash command — see README "Slack bot")
SLACK_SIGNING_SECRET=
# Bot token needs the `commands`, `users:read`, `users:read.email`, `chat:write`,
# and `im:write` scopes. The users:read pair matches Slack accounts to site users
# (menu editing, invites, password resets) — both are required, users:read.email
# alone fails with missing_scope. chat:write + im:write DM invitees their setup
# link; chat:write posts the message, im:write opens the DM.
SLACK_BOT_TOKEN=
# Who may do what is controlled by Payload roles on the linked user, not by env
# vars — see README "Slack bot".

# Distributor geocoding fallbacks
GEOCODIO_API_KEY=
BING_MAPS_API_KEY=

# Google Search Console verification
GOOGLE_SITE_VERIFICATION=
