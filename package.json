{
  "name": "lolev-beer",
  "version": "1.0.0",
  "description": "Lolev Beer brewery website with Payload CMS",
  "license": "MIT",
  "type": "module",
  "private": true,
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 102",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -H 0.0.0.0",
    "build": "pnpm migrate:prod && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "preview": "pnpm build && pnpm start",
    "clean": "rm -rf .next",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:prod": "if [ \"$VERCEL_ENV\" = production ]; then pnpm migrate; fi",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.71.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.1",
    "mapbox-gl": "^3.29.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "payload": "3.88.0",
    "pdfjs-dist": "^6.3.289",
    "randomcolor": "^0.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.5",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20",
    "pnpm": "^9 || ^10"
  }
}
