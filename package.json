{
  "name": "lolev-beer",
  "version": "1.0.0",
  "description": "Lolev Beer brewery website with Payload CMS",
  "license": "MIT",
  "type": "module",
  "private": true,
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 102",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -H 0.0.0.0",
    "build": "pnpm migrate:prod && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "preview": "pnpm build && pnpm start",
    "clean": "rm -rf .next",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:prod": "if [ \"$VERCEL_ENV\" = production ]; then pnpm migrate; fi",
    "e2e:seed": "payload run scripts/seed-e2e.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@payloadcms/db-mongodb": "4.0.0-beta.3",
    "@payloadcms/email-resend": "4.0.0-beta.3",
    "@payloadcms/next": "4.0.0-beta.3",
    "@payloadcms/richtext-lexical": "4.0.0-beta.3",
    "@payloadcms/storage-vercel-blob": "4.0.0-beta.3",
    "@payloadcms/transformer-sharp": "4.0.0-beta.3",
    "@payloadcms/ui": "4.0.0-beta.3",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.75.2",
    "@vercel/analytics": "^2.0.1",
    "ably": "2.29.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.1",
    "mapbox-gl": "^3.33.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "payload": "4.0.0-beta.3",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.1",
    "react-map-gl": "^8.1.3",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": "^11"
  }
}
