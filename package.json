{
  "name": "lolev-beer",
  "version": "1.0.0",
  "description": "Lolev Beer brewery website with Payload CMS",
  "license": "MIT",
  "type": "module",
  "private": true,
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 102",
    "safari >= 15.6",
    "ios_saf >= 15.6"
  ],
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack -H 0.0.0.0",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "preview": "pnpm build && pnpm start",
    "clean": "rm -rf .next",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test": "pnpm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:a11y:quick": "pnpm lint && pnpm type-check"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "3.79.1",
    "@payloadcms/next": "3.79.1",
    "@payloadcms/richtext-lexical": "3.79.1",
    "@payloadcms/storage-vercel-blob": "3.79.1",
    "@payloadcms/ui": "3.79.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.71.0",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "diff": "^8.0.4",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.29.0",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.0",
    "payload": "3.79.1",
    "pdfjs-dist": "^6.2.108",
    "randomcolor": "^0.6.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.2",
    "sharp": "0.35.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.5",
    "@types/randomcolor": "^0.5.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.23",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "28.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "next": "15.5.23",
      "undici@5": "^6.28.0",
      "undici@6": "^6.28.0",
      "undici@7": "^7.29.0",
      "ajv@8": ">=8.18.0",
      "@opentelemetry/core": ">=2.8.0",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.28.1",
      "file-type": ">=21.3.1",
      "mongoose": ">=8.22.1 <9.0.0",
      "postcss": ">=8.5.23",
      "uuid": ">=11.1.1",
      "js-yaml@5": ">=5.2.2",
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@5": ">=5.0.9",
      "fast-uri": ">=3.1.5",
      "nanoid@3": ">=3.3.18",
      "svgo@3": ">=3.3.4",
      "js-yaml@4": ">=4.2.0",
      "sharp": "0.35.3"
    },
    "patchedDependencies": {
      "next@15.5.23": "patches/next@15.5.23.patch"
    }
  }
}
