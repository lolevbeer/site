{
  "aboutLocations": {
    "defaultValue": "Our flagship location in Lawrenceville is both our production brewery and taproom, where visitors can experience our beers in the space where they're created. We also have a taproom in Zelienople. A building which previously housed a Barq's bottling facility until the 1970s.

Both locations offer a curated selection of our freshest draft beers and canned offerings. We regularly host food, live events, and community gatherings, creating spaces where people can connect over a good beer.",
    "type": "textarea",
  },
  "aboutPhilosophy": {
    "defaultValue": "We focus on creating beers that are purposeful and refined.

Our approach combines traditional brewing techniques with modern innovation, always in service of flavor and quality. We source the finest ingredients, obsess over every detail of the brewing process, and refine our recipes.",
    "type": "textarea",
  },
  "distributorOhUrl": {
    "access": [
      "read",
    ],
    "type": "text",
    "validate": true,
  },
  "distributorPaUrl": {
    "access": [
      "read",
    ],
    "type": "text",
    "validate": true,
  },
  "errorMessage": {
    "defaultValue": "We encountered an unexpected error. Don't worry, your data is safe.",
    "type": "text",
  },
  "heroDescription": {
    "defaultValue": "Brewed in Pittsburgh's vibrant Lawrenceville neighborhood, housed in a historic building that has stood since 1912. Lolev focuses on modern ales, expressive lagers and oak-aged beer.

We believe that beer should be thoughtful and stimulating. Each beer we create is intended to engage your senses, crafted with attention to flavor, balance, and the experience.",
    "type": "textarea",
  },
  "heroImage": {
    "relationTo": "media",
    "type": "upload",
