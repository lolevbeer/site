{
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/sync-untappd",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "src/app/(payload)/api/[...slug]/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/sync-untappd/route.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/api/menu-stream/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://lolev.beer"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/api/events-stream/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://lolev.beer"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lolev.beer" }],
      "destination": "https://lolev.beer/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/beers",
      "destination": "/beer",
      "permanent": true
    },
    { "source": "/careers", "destination": "/jobs", "permanent": true },
    { "source": "/calendar", "destination": "/events", "permanent": true },
    { "source": "/upcoming", "destination": "/events", "permanent": true },
    { "source": "/shows", "destination": "/events", "permanent": true },
    { "source": "/performances", "destination": "/events", "permanent": true },
    { "source": "/lawrenceville", "destination": "/lolev-lawrenceville", "permanent": true },
    { "source": "/zelienople", "destination": "/lolev-zelienople", "permanent": true },
    { "source": "/menu", "destination": "/beer", "permanent": true },
    { "source": "/on-tap", "destination": "/beer", "permanent": true },
    { "source": "/tap-list", "destination": "/beer", "permanent": true },
    { "source": "/hours", "destination": "/", "permanent": true },
    { "source": "/shop", "destination": "/beer-map", "permanent": true },
    { "source": "/favicon.ico", "destination": "/favicons/favicon-32x32.png", "permanent": true },
    {
      "source": "/apple-touch-icon.png",
      "destination": "/favicons/apple-touch-icon.png",
      "permanent": true
    },
    {
      "source": "/apple-touch-icon-precomposed.png",
      "destination": "/favicons/apple-touch-icon.png",
      "permanent": true
    }
  ],
  "build": {
    "env": {
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }
}
